/// Target service levels compared in the backtest.
table 'Service Level'

	column level_pct
		dataType: int64
		formatString: 0
		isHidden
		isNameInferred
		summarizeBy: none
		sourceColumn: [level_pct]

	column 'Service level'
		dataType: string
		isNameInferred
		sortByColumn: level_pct
		summarizeBy: none
		sourceColumn: [Service level]

	partition 'Service Level' = calculated
		mode: import
		source = ```
				DATATABLE ( "level_pct", INTEGER, "Service level", STRING, { { 80, "80%" }, { 90, "90%" }, { 95, "95%" }, { 98, "98%" }, { 99, "99%" } } )
				```

