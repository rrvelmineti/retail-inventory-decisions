/// Real daily sales per product per trading day (UCI Online Retail II). Bulk orders are kept separate.
table Sales

	column product_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_code

	column date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column units
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: units

	column revenue
		dataType: double
		formatString: £#,0.00
		summarizeBy: none
		sourceColumn: revenue

	column bulk_units
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: bulk_units

	column bulk_revenue
		dataType: double
		formatString: £#,0.00
		summarizeBy: none
		sourceColumn: bulk_revenue

	partition Sales = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "daily_sales.csv") else File.Contents(DataFolder & "daily_sales.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed types" = Table.TransformColumnTypes(#"Promoted headers", {{"product_code", type text}, {"date", type date}, {"units", Int64.Type}, {"revenue", type number}, {"bulk_units", Int64.Type}, {"bulk_revenue", type number}}, "en-US")
				in
				    #"Changed types"

	annotation PBI_ResultType = Table
