/// 2011 backtest totals per product and service level.
table 'Backtest Summary'

	column product_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_code

	column service_level
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: service_level

	column days
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: days

	column demand_units
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: demand_units

	column sold_units
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: sold_units

	column lost_units
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: lost_units

	column stockout_days
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: stockout_days

	column fill_rate
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: fill_rate

	column avg_on_hand
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: avg_on_hand

	column avg_stock_value
		dataType: double
		formatString: £#,0
		summarizeBy: none
		sourceColumn: avg_stock_value

	column holding_cost
		dataType: double
		formatString: £#,0
		summarizeBy: none
		sourceColumn: holding_cost

	column lost_margin
		dataType: double
		formatString: £#,0
		summarizeBy: none
		sourceColumn: lost_margin

	column orders_placed
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: orders_placed

	column level_pct
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: level_pct

	partition 'Backtest Summary' = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "simulation_summary.csv") else File.Contents(DataFolder & "simulation_summary.csv"),
				    Source = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed types" = Table.TransformColumnTypes(#"Promoted headers", {{"product_code", type text}, {"service_level", type number}, {"days", Int64.Type}, {"demand_units", Int64.Type}, {"sold_units", Int64.Type}, {"lost_units", Int64.Type}, {"stockout_days", Int64.Type}, {"fill_rate", type number}, {"avg_on_hand", type number}, {"avg_stock_value", type number}, {"holding_cost", type number}, {"lost_margin", type number}, {"orders_placed", Int64.Type}}, "en-US"),
				    #"Added level key" = Table.AddColumn(#"Changed types", "level_pct", each Int64.From(Number.Round([service_level] * 100)), Int64.Type)
				in
				    #"Added level key"

	annotation PBI_ResultType = Table
