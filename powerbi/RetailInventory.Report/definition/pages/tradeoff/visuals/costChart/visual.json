{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.2.0/schema.json",
  "name": "costChart",
  "position": {
    "x": 24,
    "y": 100,
    "z": 2000,
    "height": 330,
    "width": 744,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Service Level"
                    }
                  },
                  "Property": "Service level"
                }
              },
              "queryRef": "Service Level.Service level",
              "nativeQueryRef": "Service level",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Holding Cost"
                }
              },
              "queryRef": "Key Measures.Holding Cost",
              "nativeQueryRef": "Holding Cost"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Key Measures"
                    }
                  },
                  "Property": "Lost Margin"
                }
              },
              "queryRef": "Key Measures.Lost Margin",
              "nativeQueryRef": "Lost Margin"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Service Level"
                  }
                },
                "Property": "Service level"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Holding cost + lost margin = total cost'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
